# Upstream sync harness — copy to .sandcastle/.env for local runs.
# In GitHub Actions these are injected from repository secrets.

# Agent mode: dual (default) | anthropic | openai
# dual = Claude Opus 5 parent (high) + Codex GPT-5.6 Luna children (max)
UPSTREAM_SYNC_AGENT=dual

# Anthropic — parent grill (always in dual/anthropic modes)
ANTHROPIC_API_KEY=
UPSTREAM_SYNC_ANTHROPIC_PARENT_MODEL=claude-opus-5
# Only used when UPSTREAM_SYNC_AGENT=anthropic
UPSTREAM_SYNC_ANTHROPIC_CHILD_MODEL=claude-sonnet-5

# OpenAI via Codex — children in dual mode; both roles when agent=openai
OPENAI_API_KEY=
UPSTREAM_SYNC_OPENAI_CHILD_MODEL=gpt-5.6-luna
# Fallback / openai-only parent model
UPSTREAM_SYNC_OPENAI_MODEL=gpt-5.6-luna

# Git / GitHub
UPSTREAM_REMOTE=upstream
UPSTREAM_REPO=simstudioai/sim
UPSTREAM_BRANCH=main
# Optional — defaults to current git branch / GITHUB_HEAD_REF
# TARGET_BRANCH=version-4.2-main
GITHUB_REPOSITORY=

# Comma-separated GitHub usernames requested as PR reviewers (not emails)
UPSTREAM_SYNC_PR_REVIEWERS=

# GitHub auth for sync pushes that touch `.github/workflows/*`:
# classic ghp_* with repo + workflow scopes (or fine-grained Workflows: Read and write).
# Actions GITHUB_TOKEN can never push workflow file updates (platform rule).
# In CI, fail-fast validates GH_PAT / UPSTREAM_SYNC_GH_TOKEN and ignores expired secrets.
# GH_PAT=
# UPSTREAM_SYNC_GH_TOKEN=
# GH_TOKEN=

# Cap merge range for smoke tests (0 / unset = full upstream HEAD)
# UPSTREAM_SYNC_MAX_COMMITS=1
# UPSTREAM_SYNC_UNTIL_SHA=

# OAuth alternative for local Claude Code (instead of ANTHROPIC_API_KEY)
# CLAUDE_CODE_OAUTH_TOKEN=
